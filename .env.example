# Backblaze B2 application key id
B2_KEY_ID=

# Backblaze B2 application key secret
B2_APP_KEY=

# Backblaze B2 bucket that holds all Interlude artifacts
B2_BUCKET=

# S3-compatible endpoint for the bucket's region
# Looks like https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=

# API key for google-genai, used for the scene-description calls
GOOGLE_API_KEY=

# API key for the AssemblyAI transcription provider, used via Genblaze
ASSEMBLYAI_API_KEY=

# API key for the ElevenLabs speech-synthesis provider, used via Genblaze
ELEVENLABS_API_KEY=

# API key for Paritok repeated-prefix compression
PARITOK_API_KEY=

# Set to 1 to hard-disable Paritok regardless of any other setting
PARITOK_DISABLE=

# Maximum retries for a single pipeline step before it is recorded as failed
MAX_STEP_RETRIES=

# Set to 1 to enable the Paritok compression arm
PARITOK_ENABLED=
